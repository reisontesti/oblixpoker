# Copie para `.env.local` e preencha. O `.gitignore` já ignora `.env*`.
#
# Os dois valores estão no painel do Supabase, em Settings → API. Ambos são
# públicos por natureza: a chave anon vai no bundle do navegador e é a RLS,
# não o segredo dela, que protege os dados. Por isso é a única chave que o
# Oblix usa — a `service_role` ignora RLS e nunca deve chegar ao cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave Pix do pedido de apoio. Sem ela, o bloco de apoio não aparece — melhor
# não oferecer do que oferecer um código que não leva a lugar nenhum.
# Telefone entra como +55DDDNUMERO; e-mail, CPF e chave aleatória, como são.
NEXT_PUBLIC_PIX_CHAVE=
# Aparecem no extrato de quem paga. Só ASCII: 25 e 15 caracteres, no máximo.
NEXT_PUBLIC_PIX_NOME=Oblix
NEXT_PUBLIC_PIX_CIDADE=

# Só para aplicar migrações a partir da máquina de desenvolvimento, com
# `npx tsx scripts/migrar.mts`. O app NÃO usa: o cliente fala com o Supabase
# pela chave anon, sob RLS. Pegue em Settings -> Database -> Connection string,
# aba "Session pooler" (a conexão direta é IPv6-only).
DATABASE_URL=

